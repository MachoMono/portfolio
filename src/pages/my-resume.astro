---
import Base from '../layouts/Base.astro';
import { resume } from '../data/resume.js';

const toc = [
  { id: 'intro', label: 'Intro' },
  { id: 'skills', label: 'Skills' },
  { id: 'experience', label: 'Work Experience' },
  { id: 'education', label: 'Education' },
];
---
<Base title="My Resume" toc={toc}>
  <p class="eyebrow">My Resume</p>
  <h1>{resume.name}</h1>
  <p class="mono contact"><a href={`mailto:${resume.email}`}>{resume.email}</a></p>

  <h2 id="intro">Intro</h2>
  <p class="prose intro-text">{resume.intro}</p>

  <h2 id="skills">Skills</h2>
  <dl class="skills">
    {resume.skills.map((group) => (
      <div class="skill-row">
        <dt class="mono">{group.label}</dt>
        <dd>{group.items.join(', ')}</dd>
      </div>
    ))}
  </dl>

  <h2 id="experience">Work Experience</h2>
  <div class="timeline">
    {resume.experience.map((job) => (
      <section class="row">
        <p class="when">{job.dates}</p>
        <div>
          <h3>{job.role} <span class="at">({job.company})</span></h3>
          <ul>
            {job.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </section>
    ))}
  </div>

  <h2 id="education">Education</h2>
  <div class="timeline">
    {resume.education.map((entry) => (
      <section class="row single">
        <div>
          <h3>{entry.school}</h3>
          <p>{entry.detail}</p>
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  h1 { margin-bottom: 0.5rem; }
  .contact { font-size: 0.85rem; }
  .contact a { color: var(--muted); }

  /* Same section rhythm and 11rem margin column as the case studies. */
  h2 { padding-top: 1.75rem; border-top: 1px solid var(--line); margin-top: 3rem; }
  .skills + h2 { border-top: 0; padding-top: 0; }
  .intro-text { font-size: 1.125rem; line-height: 1.75; max-width: 36rem; }

  .skills { margin: 0; }
  .skill-row { display: grid; grid-template-columns: 14rem minmax(0, 1fr); gap: 0.25rem 1.5rem; padding: 0.7rem 0; border-top: 1px solid var(--line); }
  .skill-row:last-child { border-bottom: 1px solid var(--line); }
  .skill-row dt { font-size: 0.75rem; color: var(--muted); margin: 0.25rem 0 0; }
  .skill-row dd { margin: 0; }

  .row { padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .row:last-child { border-bottom: 0; }
  .when { font-size: 0.95rem; line-height: 1.6; color: var(--muted); margin: 0 0 0.35rem; }
  .row h3 { font-size: 1.25rem; line-height: 1.35; letter-spacing: -0.015em; font-weight: 620; margin: 0 0 0.6rem; }
  .at { font-weight: 400; color: var(--muted); }
  .row ul { margin: 0; padding-left: 1.1rem; }
  .row li { font-size: 1.0625rem; line-height: 1.65; margin-bottom: 0.35rem; max-width: 36rem; }
  .row p:last-child { margin: 0; font-size: 1.0625rem; line-height: 1.65; color: var(--muted); }

  @media (max-width: 40rem) {
    .skill-row { grid-template-columns: 1fr; }
  }
  @media (min-width: 56rem) {
    .row:not(.single) { display: grid; grid-template-columns: 11rem minmax(0, 1fr); column-gap: 2.5rem; }
    .when { margin: 0.3rem 0 0; }
  }
</style>
