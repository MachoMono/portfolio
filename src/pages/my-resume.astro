---
import Base from '../layouts/Base.astro';
import { resume } from '../data/resume.js';

const toc = [
  { id: 'intro', label: 'Intro' },
  { id: 'skills', label: 'Skills' },
  { id: 'experience', label: 'Work Experience' },
  { id: 'education', label: 'Education' },
];
---
<Base title="My Resume" toc={toc}>
  <p class="eyebrow">My Resume</p>
  <h1>{resume.name}</h1>
  <p class="mono contact"><a href={`mailto:${resume.email}`}>{resume.email}</a></p>

  <h2 id="intro">Intro</h2>
  <p class="prose">{resume.intro}</p>

  <h2 id="skills">Skills</h2>
  <ul class="prose">
    {resume.skills.map((skill) => <li>{skill}</li>)}
  </ul>

  <h2 id="experience">Work Experience</h2>
  <div class="timeline">
    {resume.experience.map((job) => (
      <section class="row">
        <p class="mono when">{job.dates}</p>
        <div>
          <h3>{job.role} <span class="at">({job.company})</span></h3>
          <ul>
            {job.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </section>
    ))}
  </div>

  <h2 id="education">Education</h2>
  <div class="timeline">
    {resume.education.map((entry) => (
      <section class="row single">
        <div>
          <h3>{entry.school}</h3>
          <p>{entry.detail}</p>
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  h1 { margin-bottom: 0.5rem; }
  .contact { font-size: 0.85rem; }
  .contact a { color: var(--muted); }
  .row { display: grid; grid-template-columns: 14rem minmax(0, 1fr); gap: 0.25rem 1.5rem; padding: 1.25rem 0; border-top: 1px solid var(--line); }
  .row.single { grid-template-columns: 1fr; }
  .when { font-size: 0.75rem; color: var(--muted); margin: 0.2rem 0 0; }
  .at { font-weight: 400; color: var(--muted); }
  .row ul, .row p:last-child { margin-bottom: 0; color: var(--muted); font-size: 0.95rem; }
  .row h3 { margin-bottom: 0.4rem; }
  @media (max-width: 40rem) {
    .row { grid-template-columns: 1fr; }
  }
</style>
