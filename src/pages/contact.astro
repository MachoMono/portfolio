---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
---
<Base title="Contact">
  <h1>Contact</h1>
  <div class="prose">
    <p>
      Thank you for viewing my portfolio. If you have any questions, please contact me at
      <a href={`mailto:${site.email}`}><strong>{site.email}</strong></a>.
    </p>
    <p>Take care!</p>
  </div>
</Base>
