---
import Base from '../layouts/Base.astro';
import { home, groups, getWork, url } from '../data/site.js';

const work = await getWork();
const featured = work.filter((page) => page.frontmatter.category === 'ai');
const docs = work.filter((page) => page.frontmatter.category !== 'ai');
const groupLabel = (id) => groups.find((group) => group.id === id)?.label;
const label = (page) => page.frontmatter.cardTitle ?? page.frontmatter.title;
---
<Base wide>
  <section class="hero">
    <p class="eyebrow">{home.eyebrow}</p>
    <h1>{home.headline}</h1>
    <p class="lead">{home.sub}</p>
    <p class="cta">
      <a class="btn" href="#work">View work</a>
      <a class="btn ghost" href={url('my-resume/')}>Resume</a>
    </p>
  </section>

  <section id="work" class="featured" aria-labelledby="ai-heading">
    <h2 id="ai-heading" class="label">{groupLabel('ai')}</h2>
    {featured.map((page) => (
      <article class="row">
        <a class="media" href={page.url} tabindex="-1" aria-hidden="true">
          <img src={url(`images/${page.frontmatter.card}`)} alt="" loading="lazy" />
          {page.frontmatter.video && (
            <span class="badge">
              <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M6 4l10 6-10 6z" /></svg>
              {page.frontmatter.video.badge ?? 'Watch the walkthrough'}
            </span>
          )}
        </a>
        <div class="text">
          <h3>{label(page)}</h3>
          <p>{page.frontmatter.pitch ?? page.frontmatter.summary}</p>
          <a class="more" href={page.url}>Read the case study <span aria-hidden="true">→</span></a>
        </div>
      </article>
    ))}
  </section>

  <section class="docs" aria-labelledby="docs-heading">
    <h2 id="docs-heading" class="label">Documentation</h2>
    <p class="docs-lead">Before AI, I followed docs-as-code the old-fashioned way, working as an embedded technical writer on software teams. I went through the scrum process alongside the developers and enjoyed it.</p>
    <div class="grid">
      {docs.map((page) => (
        <article class="doc">
          <a class="thumb" href={page.url} tabindex="-1" aria-hidden="true">
            <img src={url(`images/${page.frontmatter.card}`)} alt="" loading="lazy" />
          </a>
          <h3><a href={page.url}>{label(page)}</a></h3>
          <p>{groupLabel(page.frontmatter.category)}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="about" aria-labelledby="about-heading">
    <h2 id="about-heading" class="label">{home.about.heading}</h2>
    <img class="about-photo" src={url('images/caleb-larry.png')} alt="" width="96" height="96" />
    {home.about.sections.map((section) => (
      <div class="about-item">
        <h3>{section.title}</h3>
        <div>{section.text.map((para) => <p>{para}</p>)}</div>
      </div>
    ))}
    <p class="about-cta"><a class="btn accent" href={url('my-resume/')}>See my resume</a></p>
  </section>
</Base>

<style>
  .hero { padding: 3rem 0 4rem; max-width: 56rem; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 1.25rem; }
  .hero .lead { font-size: 1.2rem; margin-bottom: 1.75rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0; }
  .btn { padding: 0.7rem 1.25rem; font-size: 0.95rem; }
  .btn.ghost { background: transparent; color: var(--text); }
  .btn.accent { background: var(--accent); border-color: var(--accent); color: #fff; }

  .label { font: 500 0.78rem/1.3 var(--mono); letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); margin: 0 0 1.75rem; }
  .featured { padding-top: 3rem; border-top: 1px solid var(--line); }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 2rem 2.5rem; margin-bottom: 4rem; }
  .row:nth-of-type(even) { flex-direction: row-reverse; }
  .media { position: relative; flex: 1 1 28rem; min-width: 0; display: block; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: var(--panel); }
  .media img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .badge { position: absolute; right: 1rem; bottom: 1rem; display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.45rem 0.85rem; border-radius: 999px; background: #17181a; color: #fff; font-size: 0.82rem; font-weight: 550; }
  .text { flex: 1 1 20rem; min-width: 0; }
  .text h3 { font-size: 1.9rem; line-height: 1.2; letter-spacing: -0.02em; font-weight: 650; margin-bottom: 0.75rem; }
  .text p { font-size: 1.05rem; color: var(--muted); margin-bottom: 1.5rem; }
  .more { font-weight: 550; text-decoration: none; }
  .more:hover { text-decoration: underline; }

  .docs { margin-top: 1rem; padding-top: 3rem; border-top: 1px solid var(--line); }
  .docs-lead { max-width: 44rem; margin: 0 0 2rem; color: var(--muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 2rem 1.5rem; }
  .doc { position: relative; }
  .thumb { display: block; margin-bottom: 0.75rem; }
  .thumb img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; border: 1px solid var(--line); border-radius: 8px; transition: border-color 0.15s; }
  .doc:hover .thumb img { border-color: var(--muted); }
  .doc h3 { margin: 0; }
  .doc h3 a { color: var(--text); text-decoration: none; }
  .doc h3 a::after { content: ''; position: absolute; inset: 0; }
  .doc:hover h3 a { color: var(--accent); }
  .doc p { margin: 0; font-size: 0.88rem; color: var(--muted); }

  .about { margin-top: 4.5rem; padding-top: 3rem; border-top: 1px solid var(--line); }
  .about-photo { width: 6rem; height: 6rem; border-radius: 50%; object-fit: cover; margin-bottom: 1rem; }
  .about-item h3 { font-size: 0.95rem; line-height: 1.97rem; font-weight: 620; margin: 1.5rem 0 0; }
  .about-item p { font-size: 1.125rem; line-height: 1.75; margin: 0 0 1.25rem; max-width: 36rem; }
  .about-cta { margin: 0.75rem 0 0; }
  @media (min-width: 56rem) {
    .about-item { display: grid; grid-template-columns: 11rem minmax(0, 36rem); column-gap: 2.5rem; margin-top: 2.5rem; }
    .about-item h3 { margin: 0; }
    .about-cta { margin-left: 13.5rem; }
  }
</style>
