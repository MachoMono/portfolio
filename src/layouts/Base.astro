---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import { site, groups, url, getWork } from '../data/site.js';

// `toc` is a list of { id, label } for the "On this page" column.
const { title, description = site.tagline, toc = [], wide = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · ${site.tagline}`;
const here = Astro.url.pathname.replace(/\/?$/, '/');
const current = (href) => (here === href ? 'page' : undefined);
const inWork = here === url() || here.startsWith(url('work/'));
const work = await getWork();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <script is:inline>
      try {
        var saved = localStorage.getItem('theme');
        if (saved) document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>

    <header class="topbar">
      <div class="topbar-in">
        <a class="brand" href={url()}>
          <img class="brand-photo" src={url('images/caleb-larry.png')} alt="" width="36" height="36" />
          <span class="brand-name">{site.title}</span>
        </a>
        <nav id="site-nav" aria-label="Main">
          <a href={url('#work')} aria-current={inWork ? 'page' : undefined}>Work</a>
          <a href={url('my-resume/')} aria-current={current(url('my-resume/'))}>Resume</a>
          <a href={url('contact/')} aria-current={current(url('contact/'))}>Contact</a>
          <button class="icon-btn theme-btn" type="button">
            <span class="sr">Switch between light and dark theme</span>
            <svg class="sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="3.5" /><path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4" /></svg>
            <svg class="moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7Z" /></svg>
          </button>
        </nav>
      </div>
    </header>

    <div class="page">
      <main id="content" class:list={{ wide }}>
        <slot />
      </main>

      {toc.length > 0 && (
        <nav class="toc" aria-label="On this page">
          <p class="nav-label">On this page</p>
          {toc.map((entry) => <a href={`#${entry.id}`}>{entry.label}</a>)}
        </nav>
      )}
    </div>


    <footer class="site-foot">
      <div class="site-foot-in">
        <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
        <span class="foot-links">
          {site.linkedin && <a href={site.linkedin} target="_blank" rel="noreferrer noopener">LinkedIn</a>}
          <a href={url('contact/')}>Contact</a>
        </span>
      </div>
    </footer>

    <dialog class="lightbox" aria-label="Enlarged screenshot">
      <form method="dialog"><button class="icon-btn" aria-label="Close">✕</button></form>
      <img alt="" />
    </dialog>

    <script is:inline>
      (function () {
        var root = document.documentElement;

        document.querySelector('.theme-btn').addEventListener('click', function () {
          var dark = root.dataset.theme
            ? root.dataset.theme === 'dark'
            : matchMedia('(prefers-color-scheme: dark)').matches;
          root.dataset.theme = dark ? 'light' : 'dark';
          try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
        });


        var box = document.querySelector('.lightbox');
        var big = box.querySelector('img');
        document.querySelectorAll('a[data-zoom]').forEach(function (link) {
          link.addEventListener('click', function (event) {
            if (!box.showModal) return;
            event.preventDefault();
            big.src = link.href;
            big.alt = link.querySelector('img').alt;
            box.showModal();
          });
        });
        box.addEventListener('click', function (event) {
          if (event.target === box) box.close();
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fdfdfc;
    --panel: #f6f6f3;
    --text: #17181a;
    --muted: #60646b;
    --line: #e3e3de;
    --accent: #0b7a5c;
    --accent-soft: #e6f3ee;
    --radius: 8px;
    --sans: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --mono: 'JetBrains Mono Variable', ui-monospace, 'SF Mono', Menlo, monospace;
    --sidebar: 17rem;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #0f1011;
      --panel: #16181a;
      --text: #ececea;
      --muted: #9a9ea6;
      --line: #26292d;
      --accent: #4fd1a5;
      --accent-soft: #12281f;
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --bg: #0f1011;
    --panel: #16181a;
    --text: #ececea;
    --muted: #9a9ea6;
    --line: #26292d;
    --accent: #4fd1a5;
    --accent-soft: #12281f;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 5rem; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.65 var(--sans);
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3 { text-wrap: balance; }
  h1 { font-size: clamp(1.9rem, 4vw, 2.5rem); line-height: 1.15; letter-spacing: -0.025em; font-weight: 650; margin: 0 0 1rem; }
  h2 { font-size: 1.25rem; line-height: 1.3; letter-spacing: -0.015em; font-weight: 620; margin: 3rem 0 1rem; }
  h3 { font-size: 1rem; line-height: 1.4; font-weight: 600; margin: 0 0 0.3rem; }
  p { margin: 0 0 1rem; }
  ul { margin: 0 0 1rem; padding-left: 1.15rem; }
  li { margin-bottom: 0.3rem; }
  a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  a:hover { text-decoration-thickness: 2px; }
  img { max-width: 100%; height: auto; display: block; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 3px; }

  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .skip { position: absolute; left: -999px; top: 0.5rem; z-index: 20; background: var(--bg); padding: 0.5rem 0.75rem; border: 1px solid var(--line); border-radius: var(--radius); }
  .skip:focus { left: 0.5rem; }

  .mono, .nav-label, .eyebrow, .address, .mail { font-family: var(--mono); }
  .eyebrow { font-size: 0.78rem; letter-spacing: 0.02em; color: var(--accent); margin: 0 0 0.9rem; }
  .lead { font-size: 1.1rem; line-height: 1.6; color: var(--muted); max-width: 40rem; }
  .prose { max-width: 42rem; }

  .btn {
    display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; font-weight: 550;
    padding: 0.55rem 0.9rem; border-radius: var(--radius); text-decoration: none;
    background: var(--text); color: var(--bg); border: 1px solid var(--text);
  }
  .btn:hover { opacity: 0.88; }

  .icon-btn {
    display: inline-grid; place-items: center; width: 2.25rem; height: 2.25rem; padding: 0; flex: none;
    background: transparent; color: var(--muted); border: 1px solid var(--line);
    border-radius: var(--radius); cursor: pointer; font: inherit;
  }
  .icon-btn:hover { color: var(--text); border-color: var(--muted); }
  .icon-btn svg { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }

  /* Top bar */
  .topbar { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .topbar-in { max-width: 72rem; margin: 0 auto; padding: 0.7rem 2rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; }
  .brand { display: flex; align-items: center; gap: 0.7rem; color: var(--text); text-decoration: none; }
  .brand-photo { width: 2.25rem; height: 2.25rem; border-radius: 50%; object-fit: cover; flex: none; }
  .brand-name { font-weight: 620; letter-spacing: -0.01em; }
  #site-nav { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem; font-size: 0.92rem; }
  #site-nav > a { color: var(--text); text-decoration: none; padding: 0.55rem 0.8rem; border-radius: 6px; line-height: 1.2; font-weight: 500; }
  #site-nav > a:hover { background: color-mix(in srgb, var(--text) 6%, transparent); }
  #site-nav > a[aria-current='page'] { color: var(--accent); }
  #site-nav .theme-btn { width: 2.5rem; height: 2.5rem; margin-left: 0.25rem; }
  .nav-label { font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 1.4rem 0 0.35rem; padding: 0 0.6rem; }

  .site-foot { border-top: 1px solid var(--line); }
  .site-foot-in { max-width: 72rem; margin: 0 auto; padding: 1.75rem 2rem; display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; align-items: center; justify-content: space-between; }
  .mail { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); text-decoration: none; overflow-wrap: anywhere; }
  .mail:hover { color: var(--accent); }
  .foot-links { display: flex; gap: 1.25rem; font-size: 0.92rem; font-weight: 500; }
  .foot-links a { text-decoration: none; }
  .theme-btn .moon { display: none; }
  :root[data-theme='dark'] .theme-btn .sun { display: none; }
  :root[data-theme='dark'] .theme-btn .moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-btn .sun { display: none; }
    :root:not([data-theme='light']) .theme-btn .moon { display: block; }
  }

  /* Page */
  .page {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 3rem;
    max-width: 72rem; margin: 0 auto; padding: 3.5rem 2rem 5rem;
  }
  main { min-width: 0; max-width: 50rem; }
  main.wide { max-width: none; }
  .toc { display: none; }
  @media (min-width: 75rem) {
    .page:has(.toc) { grid-template-columns: minmax(0, 50rem) 11rem; justify-content: space-between; }
    .toc { display: flex; flex-direction: column; position: sticky; top: 5rem; align-self: start; font-size: 0.85rem; border-left: 1px solid var(--line); }
    .toc .nav-label { margin-top: 0; padding-left: 1rem; }
    .toc a { color: var(--muted); text-decoration: none; padding: 0.25rem 1rem; margin-left: -1px; border-left: 1px solid transparent; }
    .toc a:hover { color: var(--text); border-left-color: var(--muted); }
  }

  /* Screenshot frame */
  .shot { margin: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--panel); }
  .shot-bar { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--line); }
  .dots { display: flex; gap: 0.3rem; flex: none; }
  .dots i { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--line); }
  .address { font-size: 0.68rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .shot a { display: block; background: #fff; }
  .shot a[data-zoom] { cursor: zoom-in; }
  .shot.crop img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
  /* Thumbnails show the top of a page, so fade the bottom edge instead of cutting it hard. */
  .shot.crop a { position: relative; }
  .shot.crop a::after { content: ''; position: absolute; inset: auto 0 0; height: 22%; background: linear-gradient(rgb(255 255 255 / 0), #fff); pointer-events: none; }
  .shot figcaption { padding: 0.55rem 0.8rem; font-size: 0.82rem; color: var(--muted); border-top: 1px solid var(--line); }

  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 2rem 1.5rem; }
  .card { position: relative; }
  .card .shot { margin-bottom: 0.9rem; transition: border-color 0.15s; }
  .card:hover .shot { border-color: var(--muted); }
  .card h3 a { color: var(--text); text-decoration: none; }
  .card h3 a::after { content: ''; position: absolute; inset: 0; }
  .card:hover h3 a { color: var(--accent); }
  .card p { color: var(--muted); font-size: 0.92rem; line-height: 1.55; margin: 0; }

  .lightbox { border: 0; padding: 0; background: transparent; max-width: min(96vw, 80rem); max-height: 94vh; overflow: auto; }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.8); }
  .lightbox img { border-radius: var(--radius); background: #fff; }
  .lightbox form { position: sticky; top: 0.5rem; display: flex; justify-content: flex-end; height: 0; padding-right: 0.5rem; }
  .lightbox .icon-btn { background: #17181a; color: #fff; border-color: #17181a; }

  /* Small screens */
  @media (max-width: 40rem) {
    .topbar-in, .site-foot-in { padding-left: 1.25rem; padding-right: 1.25rem; }
    .page { padding: 2.25rem 1.25rem 3.5rem; }
  }
</style>
