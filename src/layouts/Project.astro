---
// Layout for AI Systems projects. All copy lives in the page's frontmatter so
// it can be rewritten without touching this file. Docs case studies keep using
// Work.astro.
import Base from './Base.astro';
import Shot from '../components/Shot.astro';
import { groups, getWork, url } from '../data/site.js';

const { frontmatter } = Astro.props;
const {
  title, summary, category, pitch, facts = [], gallery = [], video,
  flow = [], decisions = [], playbook, results,
} = frontmatter;

const section = groups.find((group) => group.id === category)?.label;
const [hero] = gallery;

const toc = [
  flow.length && { id: 'how-it-works', label: 'How it works' },
  decisions.length && { id: 'design-decisions', label: 'Design decisions' },
  playbook && { id: 'playbook', label: 'A playbook' },
  results && { id: 'results', label: 'Results and next' },
].filter(Boolean);

const work = await getWork();
const index = work.findIndex((page) => page.frontmatter.title === title);
const prev = work[index - 1];
const next = work[index + 1];
const label = (page) => page.frontmatter.cardTitle ?? page.frontmatter.title;
---
<Base title={title} description={summary} toc={toc}>
  {section && <p class="eyebrow">{section}</p>}
  <h1>{title}</h1>
  {pitch && <p class="lead">{pitch}</p>}

  {facts.length > 0 && (
    <dl class="facts">
      {facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
  )}

  {video ? (
    <figure class="hero-video">
      <video controls muted loop playsinline preload="metadata" poster={url(`images/${video.poster}`)} aria-label={video.alt}>
        <source src={url(`videos/${video.file}`)} type="video/mp4" />
      </video>
      {video.caption && <figcaption>{video.caption}</figcaption>}
    </figure>
  ) : hero && (
    <div class="hero-shot">
      <Shot file={hero.file} alt={hero.alt} caption={hero.caption} address={hero.address} eager />
    </div>
  )}

  <div class="prose"><slot /></div>

  {flow.length > 0 && (
    <section aria-labelledby="how-it-works">
      <h2 id="how-it-works">How it works</h2>
      <ol class="flow">
        {flow.map((step, i) => (
          <li>
            <span class="num mono" aria-hidden="true">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  {decisions.length > 0 && (
    <section aria-labelledby="design-decisions">
      <h2 id="design-decisions">Design decisions</h2>
      <div class="decisions">
        {decisions.map((decision) => (
          <article>
            <h3>{decision.title}</h3>
            <p>{decision.text}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  {playbook && (
    <section aria-labelledby="playbook">
      <h2 id="playbook">{playbook.title ?? 'A playbook'}</h2>
      {playbook.intro && <p class="intro">{playbook.intro}</p>}
      <div class="annotated">
        {playbook.parts.map((part) => (
          <div class="part">
            <pre><code>{part.code}</code></pre>
            <p class="note">{part.note}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {results && (
    <section aria-labelledby="results">
      <h2 id="results">Results and next</h2>
      <div class="results">
        <p class="status">{results.status}</p>
        {results.metrics?.length > 0 && (
          <ul class="metrics">
            {results.metrics.map((metric) => (
              <li>
                <span class="value">{metric.value}</span>
                <span class="what">{metric.label}</span>
              </li>
            ))}
          </ul>
        )}
        {results.next && <p class="next-up">{results.next}</p>}
      </div>
    </section>
  )}

  <nav class="pager" aria-label="More work">
    {prev ? <a href={prev.url}><span class="mono" aria-hidden="true">←</span>{label(prev)}</a> : <span />}
    {next ? <a class="next" href={next.url}><span class="mono" aria-hidden="true">→</span>{label(next)}</a> : <span />}
  </nav>
</Base>

<style>
  .lead { margin-bottom: 1.5rem; }

  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); gap: 0.75rem; margin: 0 0 2rem; }
  .facts div { padding: 0.75rem 0.9rem; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); }
  .facts dt { font: 0.72rem/1.3 var(--mono); color: var(--muted); letter-spacing: 0.02em; text-transform: uppercase; margin-bottom: 0.2rem; }
  .facts dd { margin: 0; font-weight: 600; line-height: 1.35; }

  .hero-shot { margin-bottom: 1rem; }
  .hero-video { margin: 0 0 1rem; max-width: 26rem; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--panel); }
  .hero-video video { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; background: #f6f3ec; }
  .hero-video figcaption { padding: 0.55rem 0.8rem; font-size: 0.82rem; color: var(--muted); border-top: 1px solid var(--line); }

  section > h2 { padding-top: 1.75rem; border-top: 1px solid var(--line); margin-top: 3rem; }
  .intro { color: var(--muted); max-width: 40rem; }

  .flow { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; counter-reset: none; }
  .flow li {
    position: relative; margin: 0; padding: 0.9rem 1rem 0.9rem 3.4rem; border: 1px solid var(--line);
    border-radius: var(--radius); background: var(--bg);
  }
  .flow li:not(:last-child)::after {
    content: ''; position: absolute; left: 1.5rem; top: 100%; width: 1px; height: 0.75rem; background: var(--line);
  }
  .flow .num {
    position: absolute; left: 0.9rem; top: 0.9rem; display: grid; place-items: center; width: 1.5rem; height: 1.5rem;
    border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-size: 0.8rem; font-weight: 600;
  }
  .flow h3 { margin-bottom: 0.15rem; }
  .flow p { margin: 0; color: var(--muted); font-size: 0.93rem; line-height: 1.55; }
  @media (min-width: 52rem) {
    .flow { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.6rem; }
    .flow li { padding: 2.9rem 0.8rem 0.9rem; }
    .flow li:not(:last-child)::after { left: 100%; top: 1.65rem; width: 0.6rem; height: 1px; }
    .flow .num { left: 0.8rem; top: 0.8rem; }
    .flow p { font-size: 0.85rem; }
  }

  .decisions { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0.9rem; }
  .decisions article { padding: 1rem 1.1rem; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); }
  .decisions p { margin: 0; color: var(--muted); font-size: 0.93rem; line-height: 1.55; }

  .annotated { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .part { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
  .part + .part { border-top: 1px solid var(--line); }
  .part pre {
    margin: 0; padding: 0.8rem 1rem; background: var(--panel); white-space: pre-wrap; overflow-wrap: anywhere;
    font: 0.82rem/1.6 var(--mono);
  }
  .part code { font: inherit; }
  .part .note { margin: 0; padding: 0.8rem 1rem; font-size: 0.9rem; line-height: 1.55; color: var(--muted); border-left: 2px solid var(--accent); }
  @media (max-width: 40rem) {
    .part { grid-template-columns: minmax(0, 1fr); }
    .part .note { border-left: 0; border-top: 2px solid var(--accent); }
  }

  .results { padding: 1.1rem 1.2rem; border: 1px solid var(--line); border-radius: var(--radius); }
  .results .status { font-weight: 600; margin-bottom: 0.75rem; }
  .metrics { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 0.75rem; }
  .metrics li { margin: 0; padding: 0.7rem 0.85rem; background: var(--accent-soft); border-radius: var(--radius); }
  .metrics .value { display: block; font-weight: 650; font-size: 1.15rem; line-height: 1.3; }
  .metrics .what { display: block; font-size: 0.82rem; color: var(--muted); }
  .results .next-up { margin: 0; color: var(--muted); }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 4rem; }
  .pager a {
    display: flex; flex-direction: column; gap: 0.2rem; padding: 0.9rem 1rem; border: 1px solid var(--line);
    border-radius: var(--radius); color: var(--text); text-decoration: none; font-weight: 550; line-height: 1.35;
  }
  .pager a:hover { border-color: var(--accent); }
  .pager .next { text-align: right; }
  .pager .mono { color: var(--muted); font-weight: 400; }
</style>
