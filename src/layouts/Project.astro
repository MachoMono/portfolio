---
// Layout for AI Systems projects. All copy lives in the page's frontmatter so
// it can be rewritten without touching this file. Docs case studies keep using
// Work.astro.
import Base from './Base.astro';
import Shot from '../components/Shot.astro';
import { groups, getWork, url } from '../data/site.js';

const { frontmatter } = Astro.props;
const {
  title, summary, category, pitch, facts = [], gallery = [], video,
  flow = [], decisions = [], screens = [], playbook, results,
} = frontmatter;

const section = groups.find((group) => group.id === category)?.label;
const [hero] = gallery;

const toc = [
  flow.length && { id: 'how-it-works', label: 'How it works' },
  decisions.length && { id: 'design-decisions', label: 'Design decisions' },
  screens.length && { id: 'interface', label: 'The interface' },
  playbook && { id: 'playbook', label: 'A playbook' },
  results && { id: 'results', label: 'Results and next' },
].filter(Boolean);

const work = await getWork();
const index = work.findIndex((page) => page.frontmatter.title === title);
const prev = work[index - 1];
const next = work[index + 1];
const label = (page) => page.frontmatter.cardTitle ?? page.frontmatter.title;
---
<Base title={title} description={summary} toc={toc}>
  {section && <p class="eyebrow">{section}</p>}
  <h1>{title}</h1>
  {pitch && <p class="lead">{pitch}</p>}

  {facts.length > 0 && (
    <dl class="facts">
      {facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
  )}

  {video ? (
    <div class="story-wrap">
      <figure class="hero-video">
        <video controls muted loop playsinline preload="metadata" poster={url(`images/${video.poster}`)} aria-label={video.alt}>
          <source src={url(`videos/${video.file}`)} type="video/mp4" />
        </video>
        {video.caption && <figcaption>{video.caption}</figcaption>}
      </figure>
      <div class="prose story"><slot /></div>
    </div>
  ) : (
    <>
      {hero && (
        <div class="hero-shot">
          <Shot file={hero.file} alt={hero.alt} caption={hero.caption} address={hero.address} eager />
        </div>
      )}
      <div class="prose story"><slot /></div>
    </>
  )}

  {flow.length > 0 && (
    <section aria-labelledby="how-it-works">
      <h2 id="how-it-works">How it works</h2>
      <ol class="rows">
        {flow.map((step, i) => (
          <li>
            <h3><span class="num mono" aria-hidden="true">{i + 1}</span>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  {decisions.length > 0 && (
    <section aria-labelledby="design-decisions">
      <h2 id="design-decisions">Design decisions</h2>
      <div class="decisions">
        {decisions.map((decision) => (
          <article>
            <h3>{decision.title}</h3>
            <p>{decision.text}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  {screens.length > 0 && (
    <section aria-labelledby="interface">
      <h2 id="interface">The interface</h2>
      <div class="screens">
        {screens.map((shot) => (
          <div class="screen">
            {shot.caption && <p class="cap">{shot.caption}</p>}
            <Shot file={shot.file} alt={shot.alt} />
          </div>
        ))}
      </div>
    </section>
  )}

  {playbook && (
    <section aria-labelledby="playbook">
      <h2 id="playbook">{playbook.title ?? 'A playbook'}</h2>
      {playbook.intro && <p class="intro">{playbook.intro}</p>}
      <div class="annotated">
        {playbook.parts.map((part) => (
          <div class="part">
            <p class="note">{part.note}</p>
            <pre><code>{part.code}</code></pre>
          </div>
        ))}
      </div>
    </section>
  )}

  {results && (
    <section aria-labelledby="results">
      <h2 id="results">Results and next</h2>
      <div class="results">
        <p class="status">{results.status}</p>
        {results.metrics?.length > 0 && (
          <ul class="metrics">
            {results.metrics.map((metric) => (
              <li>
                <span class="value">{metric.value}</span>
                <span class="what">{metric.label}</span>
              </li>
            ))}
          </ul>
        )}
        {results.next && <p class="next-up">{results.next}</p>}
      </div>
    </section>
  )}

  <nav class="pager" aria-label="More work">
    {prev ? <a href={prev.url}><span class="mono" aria-hidden="true">←</span>{label(prev)}</a> : <span />}
    {next ? <a class="next" href={next.url}><span class="mono" aria-hidden="true">→</span>{label(next)}</a> : <span />}
  </nav>
</Base>

<style>
  .lead { margin-bottom: 1.5rem; }

  /* Narrative: short subheads in a left margin column, body in a narrow measure. */
  .story { max-width: none; margin-top: 2.5rem; }
  .story-wrap .story { margin-top: 0; }
  @media (min-width: 56rem) {
    /* Video beside the story: it stays in view while the text scrolls past. */
    .story-wrap { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; gap: 3rem; align-items: start; }
    .story-wrap .hero-video { grid-column: 2; grid-row: 1; position: sticky; top: 5rem; margin: 0; max-width: none; }
    .story-wrap .story { grid-column: 1; grid-row: 1; display: block; }
    .story-wrap .story :global(h2) { margin: 2.5rem 0 0.25rem; }
    .story-wrap .story :global(h2:first-child) { margin-top: 0; }
    .story-wrap .story :global(h2 + p), .story-wrap .story :global(h2:first-child + p) { margin-top: 0; }
  }
  .story :global(p) { font-size: 1.125rem; line-height: 1.75; margin: 0 0 1.25rem; max-width: 36rem; }
  .story :global(h2) { font-size: 0.95rem; line-height: 1.97rem; font-weight: 620; letter-spacing: 0; color: var(--text); margin: 0 0 0.5rem; padding: 0; border: 0; }
  @media (min-width: 56rem) {
    .story { display: grid; grid-template-columns: 11rem minmax(0, 36rem); column-gap: 2.5rem; }
    .story :global(h2) { grid-column: 1; margin: 2.75rem 0 0; }
    .story :global(p) { grid-column: 2; }
    .story :global(h2:first-child) { margin-top: 0; }
    .story :global(h2 + p) { margin-top: 2.75rem; }
    .story :global(h2:first-child + p) { margin-top: 0; }
  }

  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); gap: 0.75rem; margin: 0 0 2rem; }
  .facts div { padding: 0.75rem 0.9rem; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); }
  .facts dt { font: 0.72rem/1.3 var(--mono); color: var(--muted); letter-spacing: 0.02em; text-transform: uppercase; margin-bottom: 0.2rem; }
  .facts dd { margin: 0; font-weight: 600; line-height: 1.35; }

  .hero-shot { margin-bottom: 1rem; }
  .hero-video { margin: 0 0 2rem; max-width: 26rem; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--panel); }
  .hero-video video { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; background: #f6f3ec; }
  .hero-video figcaption { padding: 0.55rem 0.8rem; font-size: 0.82rem; color: var(--muted); border-top: 1px solid var(--line); }

  section > h2 { padding-top: 1.75rem; border-top: 1px solid var(--line); margin-top: 3rem; }
  .intro { color: var(--muted); max-width: 40rem; }

  /* Shared row pattern: heading in a left margin column, text on the right. */
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li { margin: 0; padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  .rows li:last-child, .decisions article:last-child { border-bottom: 0; }
  .rows h3 { font-size: 1rem; line-height: 1.6; margin: 0 0 0.35rem; display: flex; gap: 0.75rem; }
  .rows .num { color: var(--accent); font-size: 0.85rem; line-height: 1.9; flex: none; min-width: 0.8rem; }
  .rows p { margin: 0; font-size: 1.0625rem; line-height: 1.7; max-width: 36rem; }
  @media (min-width: 56rem) {
    .rows li { display: grid; grid-template-columns: 11rem minmax(0, 36rem); column-gap: 2.5rem; align-items: baseline; }
    .rows h3 { margin: 0; }
  }

  .decisions article { padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .decisions h3 { font-size: 1.25rem; line-height: 1.35; letter-spacing: -0.015em; font-weight: 620; margin: 0 0 0.4rem; }
  .decisions p { margin: 0; max-width: 38rem; font-size: 1.0625rem; line-height: 1.7; color: var(--muted); }

  .screens { display: grid; gap: 2.5rem; }
  .screen .cap { margin: 0 0 0.75rem; font-size: 0.95rem; line-height: 1.6; color: var(--muted); }
  @media (min-width: 56rem) {
    .screen { display: grid; grid-template-columns: 11rem minmax(0, 1fr); column-gap: 2.5rem; align-items: start; }
    .screen .cap { margin: 0; padding-top: 0.5rem; }
  }

  /* Playbook: each annotation sits in the left margin beside its piece of the file. */
  .annotated { display: grid; gap: 1.25rem; }
  .part .note { margin: 0 0 0.5rem; font-size: 0.95rem; line-height: 1.6; color: var(--muted); }
  .part pre {
    margin: 0; padding: 0.9rem 1.1rem; background: var(--panel); border-radius: var(--radius); border-left: 3px solid var(--accent);
    white-space: pre-wrap; overflow-wrap: anywhere; font: 0.85rem/1.65 var(--mono);
  }
  .part code { font: inherit; }
  @media (min-width: 56rem) {
    .part { display: grid; grid-template-columns: 11rem minmax(0, 1fr); column-gap: 2.5rem; align-items: start; }
    .part .note { margin: 0; padding-top: 0.5rem; }
  }

  /* Results: plain statement, big numbers, no box. */
  .results .status { font-size: 1.25rem; line-height: 1.4; letter-spacing: -0.015em; font-weight: 620; margin: 0 0 1.5rem; max-width: 38rem; }
  .metrics { list-style: none; margin: 0 0 1.5rem; padding: 0; display: flex; flex-wrap: wrap; gap: 1.5rem 3.5rem; }
  .metrics li { margin: 0; }
  .metrics .value { display: block; font-weight: 650; font-size: 2.75rem; line-height: 1.1; letter-spacing: -0.03em; color: var(--accent); }
  .metrics .what { display: block; margin-top: 0.25rem; font-size: 0.95rem; color: var(--muted); }
  .results .next-up { margin: 0; max-width: 38rem; font-size: 1.0625rem; line-height: 1.7; color: var(--muted); }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 4rem; }
  .pager a {
    display: flex; flex-direction: column; gap: 0.2rem; padding: 0.9rem 1rem; border: 1px solid var(--line);
    border-radius: var(--radius); color: var(--text); text-decoration: none; font-weight: 550; line-height: 1.35;
  }
  .pager a:hover { border-color: var(--accent); }
  .pager .next { text-align: right; }
  .pager .mono { color: var(--muted); font-weight: 400; }
</style>
