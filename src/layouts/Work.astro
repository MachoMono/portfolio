---
import Base from './Base.astro';
import { url } from '../data/site.js';

const { frontmatter } = Astro.props;
const { title, summary, liveUrl, liveLabel, gallery = [] } = frontmatter;
---
<Base title={title} description={summary}>
  <p class="meta back"><a href={url()}>← Portfolio</a></p>
  <h1>{title}</h1>

  <div class="prose">
    <slot />
    {liveUrl && (
      <p class="meta"><a href={liveUrl} target="_blank" rel="noreferrer noopener">{liveLabel ?? 'View the live documentation'} ↗</a></p>
    )}
  </div>

  {gallery.length > 0 && (
    <div class="gallery">
      {gallery.map((shot) => (
        <figure class="shot">
          <a href={url(`images/${shot.file}`)}>
            <img src={url(`images/${shot.file}`)} alt={shot.alt} loading="lazy" />
          </a>
          {shot.caption && <figcaption>{shot.caption}</figcaption>}
        </figure>
      ))}
    </div>
  )}
</Base>

<style>
  .back { font-size: 0.9rem; margin-bottom: 1.5rem; }
  .back a { color: var(--muted); text-decoration: none; }
  .back a:hover { color: var(--accent); }
  .gallery { display: grid; gap: 1.5rem; margin-top: 2rem; }
</style>
